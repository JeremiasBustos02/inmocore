        "members can read organizations": {
          "name": "members can read organizations",
          "as": "PERMISSIVE",
          "for": "SELECT",
          "to": [
            "authenticated"
          ],
          "using": "exists (\n        select 1\n        from memberships\n        where memberships.organization_id = \"organizations\".\"id\"\n          and memberships.user_id = (select auth.uid())\n      )"
        }
      },
      "checkConstraints": {
        "organizations_custom_domain_normalized": {
          "name": "organizations_custom_domain_normalized",
          "value": "\"organizations\".\"custom_domain\" is null or (\n        \"organizations\".\"custom_domain\" = lower(\"organizations\".\"custom_domain\")\n        and \"organizations\".\"custom_domain\" ~ '^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)+$'\n        and length(\"organizations\".\"custom_domain\") <= 253\n      )"
        },
        "organizations_site_variant_valid": {
          "name": "organizations_site_variant_valid",
          "value": "\"organizations\".\"site_variant\" in ('default', 'editorial')"
        },
        "organizations_contact_coordinates_complete": {
          "name": "organizations_contact_coordinates_complete",
          "value": "(\"organizations\".\"contact_latitude\" is null and \"organizations\".\"contact_longitude\" is null) or (\"organizations\".\"contact_latitude\" is not null and \"organizations\".\"contact_longitude\" is not null)"
        },
        "organizations_contact_latitude_valid": {
          "name": "organizations_contact_latitude_valid",
          "value": "\"organizations\".\"contact_latitude\" is null or \"organizations\".\"contact_latitude\" between -90 and 90"
        },
        "organizations_contact_longitude_valid": {
          "name": "organizations_contact_longitude_valid",
          "value": "\"organizations\".\"contact_longitude\" is null or \"organizations\".\"contact_longitude\" between -180 and 180"
        }
